# ==================== 消防智能执法系统 环境变量模板 ====================
# 使用方式：
#   cp .env.example .env   然后填入真实值
# .env 已被 .gitignore 忽略，切勿提交真实密钥
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- DeepSeek API（LLM，必填）----
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 阿里云百炼（Agent2 TTS / Agent3 VLM，可留空）----
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=beijing
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 百度 OCR（Agent3，可留空则跳过 OCR）----
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# ---- 讯飞（Agent2 ASR，可留空）----
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
LFASR_SECRET_KEY=
# 热词（逗号分隔，可留空）
LFASR_HOT_WORDS=

# ---- Agent3 模型 ----
VLM_MODEL=qwen3-vl-flash
JUDGE_MODEL=qwen-plus
# YOLO 权重绝对路径；留空则用 <project>/agent3/input/fire_yolo/weights/best.pt
YOLO_WEIGHTS=

# ---- 离线 ASR（Agent2，可留空走默认缓存）----
# faster-whisper 模型名或本地路径（small/medium/large 或绝对路径）
WHISPER_MODEL_PATH=
WHISPER_DOWNLOAD_ROOT=
# Vosk 中文模型绝对路径
VOSK_MODEL_PATH=

# ---- 本地 LLM（Agent2 语音问答，可留空）----
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:7b

# ---- TTS ----
TTS_VOICE_EDGE=zh-CN-XiaoxiaoNeural
TTS_EMOTION=正常
COSYVOICE_MODEL=cosyvoice-v2
CLONED_VOICE_ID=

# ---- Embedding（Agent1 索引依赖，建库后不可更改）----
# 留空则自动探测 localhost:11434/v1
OLLAMA_BASE_URL=
EMBEDDING_MODEL=quentinz/bge-large-zh-v1.5

# ---- 模型缓存根目录（留空则 <project>/models）----
MODEL_CACHE_DIR=

# ==================== 鉴权 ====================

# JWT 签名密钥（必填，生产环境务必替换为随机值）
JWT_SECRET=change-me-to-a-random-secret
JWT_ISSUER=fire-agents
JWT_EXPIRE_MIN=480

# Agent 间内部调用共享 Token（留空 = 关闭内部校验，仅本地调试）
AGENT_SHARED_TOKEN=

# 设为 1 跳过 JWT 鉴权（仅限本地开发，生产环境必须为 0）
AUTH_DISABLED=0

# ==================== 基础设施 ====================

# Redis（留空 = 禁用异步任务接口）
REDIS_URL=redis://127.0.0.1:6379/0

# Milvus（留空 = 自动回退 FAISS）
MILVUS_URI=
MILVUS_COLLECTION=fire_laws

# ==================== 可观测性（留空 = 关闭） ====================

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ==================== 预算控制 ====================

BUDGET_MAX_TOKENS=200000
BUDGET_MAX_COST=10

# ==================== 编排与路由 ====================

# langgraph = 状态图编排（生产）；legacy = 原多模态编排
ORCHESTRATOR_MODE=langgraph

# L2 分类器置信度阈值，低于则升级到 L3 LLM 判定
CLASSIFIER_CONF_THRESHOLD=0.6

# 级联路由最大升级跳数，超限转人工
ROUTE_MAX_HOPS=3

# ==================== 部署 ====================

REGISTRY=
BASE_IMAGE=python:3.10-slim
