# ==================== 消防智能执法系统 环境变量模板 ====================
# 使用方式：
#   cp .env.example .env   然后填入真实值
# .env 已被 .gitignore 忽略，切勿提交真实密钥
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- DeepSeek API（LLM，必填）----
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 阿里云百炼（视觉 VLM + Embedding 备选，可留空）----
DASHSCOPE_API_KEY=

# ---- 百度 OCR（Agent3 视觉，可留空则跳过 OCR）----
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# ---- Ollama（本地 Embedding + Whisper，自动探测，通常留空）----
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ==================== 鉴权 ====================

# JWT 签名密钥（必填，生产环境务必替换为随机值）
JWT_SECRET=change-me-to-a-random-secret
JWT_ISSUER=fire-agents
JWT_EXPIRE_MIN=480

# Agent 间内部调用共享 Token（留空 = 关闭内部校验，仅本地调试）
AGENT_SHARED_TOKEN=

# 设为 1 跳过 JWT 鉴权（仅限本地开发，生产环境必须为 0）
AUTH_DISABLED=0

# ==================== 基础设施 ====================

# Redis（留空 = 禁用异步任务接口）
REDIS_URL=redis://127.0.0.1:6379/0

# Milvus（留空 = 自动回退 FAISS）
MILVUS_URI=
MILVUS_COLLECTION=fire_laws

# ==================== 可观测性（留空 = 关闭） ====================

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ==================== 预算控制 ====================

BUDGET_MAX_TOKENS=200000
BUDGET_MAX_COST=10

# ==================== 编排与路由 ====================

# langgraph = 状态图编排（生产）；legacy = 原多模态编排
ORCHESTRATOR_MODE=langgraph

# L2 分类器置信度阈值，低于则升级到 L3 LLM 判定
CLASSIFIER_CONF_THRESHOLD=0.6

# 级联路由最大升级跳数，超限转人工
ROUTE_MAX_HOPS=3

# ==================== 部署 ====================

REGISTRY=
BASE_IMAGE=python:3.10-slim
