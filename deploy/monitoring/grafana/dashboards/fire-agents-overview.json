  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "消防智能执法系统 · 服务可观测总览。\n\n组织逻辑按「出问题时先看哪个数」排：\n1. 服务健康总览 —— 先确认是不是服务挂了\n2. 请求与延迟 —— 再看是不是慢\n3. RAG 检索 —— 检索不出东西时看这里\n4. LLM 调用与成本 —— 端到端延迟的主要构成\n5. 韧性与预算 —— 下游不稳定与成本失控时看这里",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "服务健康总览",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "在线服务数",
      "description": "四个服务里有多少个Prometheus 能抓到 /metrics。掉到 3 以下说明有服务没起来或没暴露端点。",
      "datasource": {
        "type": "prometheus",
        "uid": "fire-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fire-prom"
          },
          "expr": "sum(up{job=~\"agent1|agent2|agent3|gateway\"})",
          "legendFormat": "up",
          "refId": "A",
          "interval": "",
          "editorMode": "code"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "请求速率 (req/s)",
      "description": "全部服务的请求速率。持续为 0 说明流量没进来。",
      "datasource": {
        "type": "prometheus",
        "uid": "fire-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fire-prom"
          },
          "expr": "sum(rate(fire_http_requests_total[1m]))",
          "legendFormat": "req/s",
          "refId": "A",
          "interval": "",
          "editorMode": "code"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "错误率",
      "description": "5xx 占比。超过 1% 需要查日志；持续 5% 以上说明有服务崩了。",
      "datasource": {
        "type": "prometheus",
        "uid": "fire-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 9,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fire-prom"
          },
          "expr": "sum(rate(fire_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(fire_http_requests_total[5m])), 0.001)",
          "legendFormat": "err",
          "refId": "A",
          "interval": "",
          "editorMode": "code"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "P99 延迟",
      "description": "全局 P99。注意：桶边界决定了分辨率，最细一档是 10s，超过 10s 的延迟都会落进 +Inf 桶。",
