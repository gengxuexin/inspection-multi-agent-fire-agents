        "h": 5,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fire-prom"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fire_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "A",
          "interval": "",
          "editorMode": "code"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
